# Copy this file to .env, then fill it in locally. Never use your normal login
# password. Use a dedicated SMTP app password; never commit the filled file.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURITY=ssl
SMTP_USERNAME=
SMTP_APP_PASSWORD=
SMTP_FROM=

# Phase 2 accounts. Generate JWT_SECRET_KEY once using secrets.token_hex(48).
# Leave DATABASE_URL blank for the private local .instance SQLite database.
# Production requires managed PostgreSQL and an HTTPS PUBLIC_ORIGIN.
JWT_SECRET_KEY=
DATABASE_URL=
FOCUSLENS_ENV=development
PUBLIC_ORIGIN=http://localhost:8001
TRUST_PROXY=0

# Google Identity Services web client ID (public identifier, not a secret).
# ID-token verification does not require a Google client secret.
GOOGLE_CLIENT_ID=

# Hosted reports over HTTPS (SMTP is blocked on Render's free service).
# Add a verified sender and API key in the email provider, then keep the key private.
REPORT_TRANSPORT=smtp
BREVO_API_KEY=
REPORT_FROM_EMAIL=

# Free Home Screen companion Web Push. Generate once with configure_web_push.py.
# The public key is derived from this private key; only the public key is sent to browsers.
WEB_PUSH_PRIVATE_KEY=
WEB_PUSH_SUBJECT=mailto:your-contact@example.com
